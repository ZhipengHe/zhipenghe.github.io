---
layout: default
---
<div class="post about-page">
  <div class="about-hero">
    <header class="post-header about-inscription">
      <div class="about-spine" lang="zh-Hans">{{ site.cn_name }}</div>
      <div class="about-spine-text">
        <h1 class="post-title">
          <span class="font-weight-bold">{{ site.first_name }}</span> "{{ site.nickname }}" {{ site.last_name }}
        </h1>
        <p class="desc">{{ page.subtitle }}</p>
      </div>
    </header>

    {% if page.profile %}
      <div class="about-portrait">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: 576px) 190px, 95vw{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <article>
    {% comment %}
      The page body splits at the focus marker: the bio renders first, then the
      research focus strip, and the remaining sections (education, honors)
      move below the news and publications.
    {% endcomment %}
    {% assign content_parts = content | split: '<!-- focus -->' %}
    <div class="clearfix">{{ content_parts[0] }}</div>

    <!-- Research focus -->
    {% if page.focus %}
      <div class="about-focus">
        {% for item in page.focus %}
          <div>
            <h3>
              {% if item.url -%}
                <a href="{{ item.url | relative_url }}" style="color: inherit">{{ item.title }}</a>
              {%- else -%}
                {{- item.title -}}
              {%- endif %}
            </h3>
            <p>{{ item.text }}</p>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Remaining page sections (education, honors) -->
    {% if content_parts.size > 1 %}
      <div class="clearfix about-credentials">{{ content_parts[1] }}</div>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>
</div>

{% comment %}
  Person schema for the homepage. The theme emits a generic WebSite block in the
  head; this block tells search engines and AI assistants who the site is about,
  what the current role is, and which external profiles are the same person.
{% endcomment %}
{% assign topics = site.keywords | split: ', ' %}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "{{ site.url }}{{ site.baseurl }}/#person",
    "name": "{{ site.first_name }} {{ site.last_name }}",
    "alternateName": ["{{ site.nickname }} {{ site.last_name }}", "{{ site.cn_name }}"],
    "givenName": "{{ site.first_name }}",
    "familyName": "{{ site.last_name }}",
    "url": "{{ site.url }}{{ site.baseurl }}/",
    "image": "{{ site.url }}{{ site.baseurl }}/assets/img/{{ page.profile.image }}",
    "email": "mailto:{{ site.email }}",
    "jobTitle": "Postdoctoral Fellow",
    "worksFor": {
      "@type": "Organization",
      "name": "Queensland University of Technology",
      "alternateName": "QUT",
      "url": "https://www.qut.edu.au/",
      "department": {
        "@type": "Organization",
        "name": "School of Mechanical, Medical and Process Engineering"
      }
    },
    "alumniOf": [
      {
        "@type": "CollegeOrUniversity",
        "name": "Queensland University of Technology",
        "url": "https://www.qut.edu.au/"
      },
      {
        "@type": "CollegeOrUniversity",
        "name": "Jinling Institute of Technology"
      }
    ],
    "knowsAbout": [{% for topic in topics %}"{{ topic }}"{% unless forloop.last %}, {% endunless %}{% endfor %}],
    "sameAs": [
      "https://orcid.org/{{ site.data.socials.orcid_id }}",
      "https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}",
      "https://github.com/{{ site.data.socials.github_username }}",
      "https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}",
      "{{ site.data.socials.dblp_url }}"
    ]
  }
</script>
